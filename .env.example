# Copy to .env at the repo root and fill in. Never commit the real file.
# Every LLM and embedding call in this benchmark goes through shared/azure_client.py,
# which reads this file.

# --- LLM endpoint (required) ---------------------------------------------
# shared/azure_client.py supports two endpoint shapes and picks by URL:
#
#   .../v1                  OpenAI-compatible gateway (UMich's umgpt toolkit is
#                           one, behind Portkey). Bearer auth. AZURE_API_VERSION
#                           is ignored, and the deployment name below is sent
#                           straight through as the model.
#   *.openai.azure.com      Azure OpenAI. api-key header, deployment in the URL.
#
# Pointing an Azure-style client at a /v1 gateway returns 401 "Invalid API Key"
# even when the key is fine, which is why the shape matters.
AZURE_API_KEY="<your-key>"
AZURE_API_BASE="https://api.example.edu/v1"
AZURE_API_VERSION="2024-12-01-preview"     # Azure endpoints only

# Deployment names as they appear in your Azure resource. On Azure the
# deployment name is what you pass as `model`, so these must match exactly.
AZURE_DEPLOYMENT="gpt-5"
AZURE_EMBED_DEPLOYMENT="text-embedding-3-large"

# Only needed if your endpoint requires an org header (UMich's does).
# OPENAI_ORG_ID="<org-id>"

# --- optional -------------------------------------------------------------
# Repo root. Unset is fine: every script resolves it from its own location.
# Set it only to run scripts from a copy of the tree.
# BENCH_ROOT="/path/to/bench"

# Directory holding NarrativeQA's qaps.csv / documents.csv. Needed only by the
# corpus-prep scripts (methods/wiki_v7_window/select_nqa.py, prepare_nqa.py);
# the prepared corpus under data/ is already committed. Defaults to the repo's parent.
# NQA_META_DIR="/path/to/narrativeqa-metadata"
